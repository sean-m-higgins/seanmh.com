---
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/manrope';
import '../styles/gaudi.css';
import '../styles/collections.css';
interface Props { title?: string; description?: string; }
const {title = 'Casa Higgins — A house for the things I make', description = 'Software, woodworking, art, and an Eagle Scout project. Seven rooms for the things Sean Higgins makes, shaped by the architecture of Antoni Gaudí.'} = Astro.props;
---
<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} /><meta name="theme-color" content="#f5efdf" /><meta name="portfolio-version" content="h-gaudi" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content="https://seanmh.com/" /><meta property="og:image" content="https://seanmh.com/gaudi-social.png?v=h-gaudi" /><meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href="https://seanmh.com/" /><link rel="icon" type="image/svg+xml" href="/gaudi-mark.svg" /><title>{title}</title>
</head><body><a class="skip-link" href="#main">Skip to content</a><slot /></body></html>
