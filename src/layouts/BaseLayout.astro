---
import "../styles/global.css";
import "../styles/transitions.css";
import VersionSwitcher from "../components/VersionSwitcher.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  error?: boolean;
  type?: "website" | "article";
}

const {
  title,
  description,
  canonicalPath,
  error = false,
  type = "website",
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url);
const socialImage = new URL("/travel/travel-social.png", Astro.site ?? Astro.url);
const structuredData = {
  "@context": "https://schema.org",
  "@type": type === "article" ? "TravelAction" : "WebSite",
  name: title,
  description,
  url: canonicalUrl.href,
  image: socialImage.href,
  author: {
    "@type": "Person",
    name: "Sean Higgins",
    url: "https://seanmh.com/",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#061119" />
    <meta name="portfolio-version" content="g-travel" />
    <meta name="robots" content={error ? "noindex, nofollow" : "index, follow"} />

    {!error && <link rel="canonical" href={canonicalUrl} />}
    {!error && <meta property="og:title" content={title} />}
    {!error && <meta property="og:description" content={description} />}
    {!error && <meta property="og:type" content={type} />}
    {!error && <meta property="og:url" content={canonicalUrl} />}
    {!error && <meta property="og:image" content={socialImage} />}
    {!error && <meta property="og:image:alt" content="A glowing globe tracing a route toward Norway" />}
    {!error && <meta name="twitter:card" content="summary_large_image" />}

    <link rel="icon" type="image/svg+xml" href="/travel/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/travel/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/travel/apple-touch-icon.png" />
    <title>{title}</title>
    {!error && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to the journey</a>
    <slot />
    <VersionSwitcher current="g-travel" />
  </body>
</html>
