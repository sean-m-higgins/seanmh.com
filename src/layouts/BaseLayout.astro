---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  error?: boolean;
}

const { title, description, error = false } = Astro.props;
const canonicalUrl = new URL("/systems/", Astro.site ?? Astro.url);
const socialImage = new URL("/systems/blueprint-social.png", Astro.site ?? Astro.url);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: "Blueprint — the systems behind seanmh.com",
  description,
  url: canonicalUrl.href,
  image: socialImage.href,
  author: {
    "@type": "Person",
    name: "Sean Higgins",
    url: "https://seanmh.com/",
  },
  about: [
    "Software architecture",
    "Cloudflare Workers",
    "Astro",
    "Progressive enhancement",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#071011" />
    <meta name="portfolio-version" content="f-blueprint" />
    <meta name="robots" content={error ? "noindex, nofollow" : "index, follow"} />

    {!error && <link rel="canonical" href={canonicalUrl} />}
    {!error && <meta property="og:title" content={title} />}
    {!error && <meta property="og:description" content={description} />}
    {!error && <meta property="og:type" content="article" />}
    {!error && <meta property="og:url" content={canonicalUrl} />}
    {!error && <meta property="og:image" content={socialImage} />}
    {!error && <meta property="og:image:width" content="1200" />}
    {!error && <meta property="og:image:height" content="630" />}
    {!error && <meta property="og:image:alt" content="Blueprint diagram of the systems behind seanmh.com" />}
    {!error && <meta name="twitter:card" content="summary_large_image" />}

    <link rel="icon" type="image/svg+xml" href="/systems/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/systems/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/systems/apple-touch-icon.png" />
    <title>{title}</title>
    {!error && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to the system map</a>
    <slot />
  </body>
</html>
