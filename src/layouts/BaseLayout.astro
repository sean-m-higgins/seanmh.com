---
import "../styles/global.css";
import "../styles/transitions.css";
import "../styles/scroll.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import VersionSwitcher from "../components/VersionSwitcher.astro";
import Loader from "../components/Loader.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Sean Higgins is a software engineer specializing in authentication, API platforms, data engineering, and machine learning.",
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en" class="dark overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="portfolio-version" content="a-scroll" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- No-JS: never trap the page behind the intro loader. -->
    <noscript><style>#loader { display: none !important; }</style></noscript>

    <!-- Dark mode: read preference before paint to avoid flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        if (stored === "light") {
          document.documentElement.classList.remove("dark");
        } else if (stored === "dark") {
          document.documentElement.classList.add("dark");
        } else if (!window.matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>
  <body class="min-h-screen overflow-x-clip font-sans antialiased">
    <Loader />
    <script is:inline>
      (function () {
        var l = document.getElementById("loader");
        if (!l) return;
        // Show on every load — a refresh replays the intro. Still skipped for
        // reduced motion (and no-JS, via the noscript rule).
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          l.parentNode.removeChild(l);
          return;
        }
        var removed = false;
        function done() {
          if (removed) return;
          removed = true;
          // Land a final jab, then wipe the panel up.
          l.classList.add("loader-finish");
          setTimeout(function () {
            l.classList.add("loader-done");
          }, 230);
          setTimeout(function () {
            if (l.parentNode) l.parentNode.removeChild(l);
          }, 900);
        }
        var t = setTimeout(done, 1050);
        l.addEventListener("click", function () {
          clearTimeout(t);
          done();
        });
      })();
    </script>
    <div id="scroll-progress" aria-hidden="true"></div>
    <Navigation />
    <main>
      <slot />
    </main>
    <Footer />
    <VersionSwitcher current="a-scroll" />

    <!-- Motion foundation: Lenis smooth scroll + GSAP ScrollTrigger -->
    <script>
      import { initScroll, destroyScroll } from "../scripts/scroll";

      initScroll();
      document.addEventListener("astro:page-load", initScroll);
      document.addEventListener("astro:before-swap", destroyScroll);
    </script>

  </body>
</html>
