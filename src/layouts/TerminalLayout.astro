---
import "../styles/global.css";
import VersionSwitcher from "../components/VersionSwitcher.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Sean Higgins — Software Engineer" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="portfolio-version" content="c-terminal" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <ViewTransitions />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        if (stored === "light") {
          document.documentElement.classList.remove("dark");
        } else if (stored === "dark") {
          document.documentElement.classList.add("dark");
        } else if (!window.matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script is:inline>
      // Apply persisted window state before first paint to avoid FOUC.
      (function () {
        const s = localStorage.getItem("terminalWindowState");
        if (s === "minimized" || s === "maximized" || s === "closed" || s === "normal") {
          document.documentElement.dataset.windowState = s;
        } else {
          document.documentElement.dataset.windowState = "normal";
        }
      })();
    </script>

    <style is:global>
      /* Traffic-light buttons reveal a hint glyph on hover/focus. */
      .tl-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 0.75rem;
        width: 0.75rem;
        border-radius: 9999px;
        border: 0;
        padding: 0;
        cursor: pointer;
        font-size: 0.55rem;
        line-height: 1;
        color: rgba(0, 0, 0, 0);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-weight: 700;
      }
      .tl-btn:hover,
      .tl-btn:focus-visible,
      .title-bar:hover .tl-btn {
        color: rgba(0, 0, 0, 0.55);
      }
      .tl-btn:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 2px;
      }

      /* Window state layout rules. */
      html[data-window-state="closed"] .terminal-window,
      html[data-window-state="minimized"] .terminal-window {
        display: none !important;
      }
      #terminal-closed-screen,
      #terminal-dock {
        display: none;
      }
      html[data-window-state="closed"] #terminal-closed-screen {
        display: flex;
      }
      html[data-window-state="minimized"] #terminal-dock {
        display: inline-flex;
      }

      html[data-window-state="maximized"] body {
        padding: 0 !important;
      }
      html[data-window-state="maximized"] .terminal-window {
        max-width: none !important;
        border-radius: 0 !important;
        border-width: 0 !important;
        box-shadow: none !important;
      }

      @media (prefers-reduced-motion: no-preference) {
        .terminal-window {
          transition: max-width 200ms ease, border-radius 200ms ease;
        }
      }
    </style>
  </head>
  <body class="flex h-screen items-center justify-center overflow-hidden p-4 font-mono antialiased sm:p-8">
    <!-- Terminal window -->
    <div class="terminal-window flex h-full w-full max-w-3xl flex-col overflow-hidden rounded-lg border border-neutral-300 shadow-2xl transition-colors duration-2000 dark:border-neutral-700">
      <!-- Title bar -->
      <div class="title-bar flex items-center gap-2 border-b border-neutral-300 bg-neutral-200 px-4 py-2.5 transition-colors duration-2000 dark:border-neutral-700 dark:bg-neutral-800">
        <button
          id="tl-close"
          type="button"
          aria-label="Close terminal"
          class="tl-btn bg-[#ff5f57]"
        >×</button>
        <button
          id="tl-minimize"
          type="button"
          aria-label="Minimize terminal"
          class="tl-btn bg-[#febc2e]"
        >−</button>
        <button
          id="tl-maximize"
          type="button"
          aria-label="Maximize terminal"
          class="tl-btn bg-[#28c840]"
        >+</button>
        <span class="ml-2 text-xs text-neutral-500 dark:text-neutral-400">sean@seanmh.com ~ %</span>

        <!-- Dark mode toggle -->
        <button
          id="theme-toggle"
          aria-label="Toggle dark mode"
          class="ml-auto text-neutral-500 transition-colors hover:text-neutral-800 dark:text-neutral-400 dark:hover:text-neutral-100"
        >
          <svg id="icon-sun" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-13.66l-.71.71M4.05 19.95l-.71.71M21 12h-1M4 12H3m16.66 7.66l-.71-.71M4.05 4.05l-.71-.71M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="icon-moon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </div>

      <!-- Terminal body -->
      <div class="flex-1 overflow-y-auto bg-neutral-50 p-4 text-sm leading-relaxed transition-colors duration-2000 dark:bg-[#0a0a0a] sm:p-6 sm:text-base">
        <slot />
      </div>
    </div>

    <!-- Closed state: process terminated screen -->
    <div
      id="terminal-closed-screen"
      role="dialog"
      aria-label="Terminal closed"
      class="flex-col items-center justify-center gap-4 font-mono text-sm text-neutral-600 sm:text-base dark:text-neutral-400"
    >
      <p class="text-neutral-500 dark:text-neutral-500">[process terminated]</p>
      <p>sean@seanmh.com exited with code 0.</p>
      <button
        id="terminal-relaunch"
        type="button"
        class="mt-4 rounded border border-neutral-400 px-3 py-1.5 text-neutral-800 transition-colors hover:bg-neutral-200 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
      >
        <span class="text-green-500 dark:text-green-400">$</span>
        <span class="ml-2">./relaunch</span>
      </button>
      <p class="mt-2 text-xs text-neutral-400 dark:text-neutral-600">(or press Enter / Escape)</p>
    </div>

    <!-- Minimized state: dock pill -->
    <button
      id="terminal-dock"
      type="button"
      aria-label="Restore terminal"
      class="fixed top-4 left-4 z-50 items-center gap-2 rounded-full border border-neutral-200 bg-white/80 px-3 py-1.5 text-xs font-medium shadow-lg backdrop-blur-sm transition-colors hover:bg-white dark:border-neutral-700 dark:bg-neutral-900/80 dark:hover:bg-neutral-900"
    >
      <span class="inline-block h-2 w-2 rounded-full bg-[#ff5f57]"></span>
      <span class="inline-block h-2 w-2 rounded-full bg-[#febc2e]"></span>
      <span class="inline-block h-2 w-2 rounded-full bg-[#28c840]"></span>
      <span class="ml-1 text-neutral-600 dark:text-neutral-300">sean@seanmh.com ~ %</span>
    </button>

    <VersionSwitcher />

    <script>
      function setupThemeToggle() {
        const btn = document.getElementById("theme-toggle");
        const sun = document.getElementById("icon-sun");
        const moon = document.getElementById("icon-moon");
        if (!btn || !sun || !moon) return;

        function updateIcons() {
          const isDark = document.documentElement.classList.contains("dark");
          sun.classList.toggle("hidden", !isDark);
          moon.classList.toggle("hidden", isDark);
        }

        btn.addEventListener("click", () => {
          const isDark = document.documentElement.classList.contains("dark");
          document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", isDark ? "light" : "dark");
          updateIcons();
        });

        updateIcons();
      }

      type WindowState = "normal" | "minimized" | "maximized" | "closed";

      function setupWindowControls() {
        const html = document.documentElement;
        const close = document.getElementById("tl-close") as HTMLButtonElement | null;
        const minimize = document.getElementById("tl-minimize") as HTMLButtonElement | null;
        const maximize = document.getElementById("tl-maximize") as HTMLButtonElement | null;
        const dock = document.getElementById("terminal-dock") as HTMLButtonElement | null;
        const relaunch = document.getElementById("terminal-relaunch") as HTMLButtonElement | null;
        if (!close || !minimize || !maximize || !dock || !relaunch) return;

        // `prev` is what restore should return to (only meaningful when the
        // current state is minimized or maximized and we came from the other).
        let prev: WindowState = "normal";

        function currentState(): WindowState {
          return (html.dataset.windowState as WindowState) || "normal";
        }

        function setState(next: WindowState) {
          const curr = currentState();
          if (curr === next) return;

          // Track prev only for size transitions between normal/maximized.
          if (
            (curr === "normal" || curr === "maximized") &&
            next === "minimized"
          ) {
            prev = curr;
          }

          html.dataset.windowState = next;
          try {
            localStorage.setItem("terminalWindowState", next);
          } catch {}

          // Pretext paragraph layout depends on container width. Maximize/
          // restore don't fire a real resize event, so nudge the listener
          // in src/pages/index.astro to re-run layoutWithLines.
          requestAnimationFrame(() => {
            window.dispatchEvent(new Event("resize"));
          });

          // Focus management.
          if (next === "closed") {
            relaunch.focus();
          } else if (curr === "closed") {
            close.focus();
          } else if (curr === "minimized" && next !== "minimized") {
            // Returning from dock — move focus back to a title-bar button.
            minimize.focus();
          }
        }

        close.addEventListener("click", () => setState("closed"));
        minimize.addEventListener("click", () => setState("minimized"));
        maximize.addEventListener("click", () => {
          setState(currentState() === "maximized" ? "normal" : "maximized");
        });
        dock.addEventListener("click", () => {
          setState(prev === "maximized" ? "maximized" : "normal");
        });
        relaunch.addEventListener("click", () => setState("normal"));

        // Global keyboard shortcuts active only while closed.
        document.addEventListener("keydown", (e) => {
          if (currentState() !== "closed") return;
          if (e.key === "Enter" || e.key === "Escape") {
            e.preventDefault();
            setState("normal");
          }
        });
      }

      setupThemeToggle();
      setupWindowControls();
      document.addEventListener("astro:after-swap", () => {
        setupThemeToggle();
        setupWindowControls();
      });
    </script>
  </body>
</html>
