---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { norwayTrip } from "../../content/trips.ts";

const title = "Oslo to Lofoten — Norway 2026 | Travel";
const description = norwayTrip.summary;
---

<BaseLayout title={title} description={description} canonicalPath={norwayTrip.links.overview} type="article">
  <SiteHeader compact />
  <main id="main-content" class="journal">
    <header class="journal-hero">
      <div class="journal-heading">
        <a class="back-link" href="/travel/"><span aria-hidden="true">←</span> Return to the atlas</a>
        <p class="eyebrow">Journey 001 / Norway</p>
        <h1>Oslo<br /><em>to Lofoten.</em></h1>
        <p>{norwayTrip.summary}</p>
        <div class="journal-meta">
          <span>{norwayTrip.dateLabel}</span>
          <span>Hamnøy · 67.949° N</span>
        </div>
      </div>
      <div class="journal-map" aria-label="Journey outline from Oslo to Lofoten">
        <svg viewBox="0 0 620 760" role="img">
          <title>Stylized map of Norway with Oslo, Bodø, Moskenes, and Hamnøy</title>
          <defs>
            <linearGradient id="map-fill" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#284c5b" />
              <stop offset="1" stop-color="#102a38" />
            </linearGradient>
          </defs>
          <path class="norway-shape" d="M346 720l-34-44 19-52-36-51 38-70-25-74 44-62-10-72 58-65 21-81 52-70 48 24-7 65-47 67-7 70-53 73 12 73-43 66 20 77-30 76z" />
          <path class="planned-line" d="M344 666C382 578 317 454 377 355s10-78 72-185" />
          <g class="map-stop" transform="translate(344 666)"><circle r="8"/><text x="18" y="5">Oslo</text></g>
          <g class="map-stop" transform="translate(377 355)"><circle r="8"/><text x="18" y="5">Bodø</text></g>
          <g class="map-stop" transform="translate(432 225)"><circle r="8"/><text x="18" y="5">Moskenes</text></g>
          <g class="map-stop anchor" transform="translate(449 170)"><circle r="11"/><text x="20" y="5">Hamnøy</text></g>
          <text class="map-disclaimer" x="36" y="714">PRE-TRIP SPINE · ACTUAL ROUTE PENDING CONFIRMATION</text>
        </svg>
      </div>
    </header>

    <section class="journal-intro">
      <p class="eyebrow">The shape of it</p>
      <div>
        <h2>Fly north. Cross the Vestfjorden. Pick up the road where the mountains meet it.</h2>
        <p>The plan used Bodø as the hinge: an airport close to the motorcycle, a three-hour ferry that lands beside Reine, and three weather-flexible days based in a waterfront rorbu. The plan below is preserved as it existed before departure; the route atlas will show only the confirmed journey.</p>
      </div>
    </section>

    <section class="journal-doors" aria-label="Norway journey sections">
      <div class="journal-door">
        <span>01 / Before</span>
        <h2>The itinerary</h2>
        <p>The route logic, day-by-day plan, and packing notes, kept as the document stood before departure.</p>
        <div class="download-actions">
          <a class="button button-primary" href={norwayTrip.links.pdfDownload} download>Download PDF <span aria-hidden="true">↓</span></a>
          <a class="button" href={norwayTrip.links.htmlDownload}>Read it in the browser <span aria-hidden="true">↗</span></a>
        </div>
        <p class="archive-warning">Archived August 2026 · schedules, prices, and availability need fresh verification.</p>
      </div>
      <a class="journal-door" href={norwayTrip.links.photos}>
        <span>02 / After</span>
        <h2>The photographs</h2>
        <p>A small edit from Oslo, Bodø, the ferry crossing, and Lofoten.</p>
        <i aria-hidden="true">↗</i>
      </a>
    </section>

    <aside class="truth-note">
      <span aria-hidden="true">◎</span>
      <div><strong>Plan and record stay separate.</strong><p>The pre-trip document is useful because it shows the decisions before the outcome. Actual route coordinates and photo locations will be published only after they are confirmed.</p></div>
    </aside>
  </main>
  <SiteFooter />
</BaseLayout>
