---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { norwayTrip } from "../../content/trips.ts";
import { norwayPhotos } from "../../content/photos.ts";
import { Picture } from "astro:assets";
---

<BaseLayout title="Norway Photographs | Travel" description="A concise photographic edit from Oslo, Bodø, and the Lofoten archipelago." canonicalPath={norwayTrip.links.photos} type="article">
  <SiteHeader compact />
  <main id="main-content" class="photo-journal">
    <header class="photo-hero">
      <a class="back-link" href={norwayTrip.links.overview}><span aria-hidden="true">←</span> Norway 2026</a>
      <p class="eyebrow">After / Contact sheet 001</p>
      <h1>North of<br /><em>the ordinary.</em></h1>
      <p>A deliberately small edit from the journey. The photographs are being selected from the full roll before they enter the public archive.</p>
    </header>

    {norwayPhotos.length > 0 ? (
      <div class="photo-grid">
        {norwayPhotos.map((photo, index) => (
          <figure class:list={[{ wide: photo.width > photo.height * 1.35, tall: photo.height > photo.width * 1.2 }]}>
            <button type="button" data-photo={index} aria-label={`Open photograph: ${photo.alt}`}>
              <Picture
                src={photo.src}
                formats={["avif", "webp"]}
                widths={[480, 768, 1200, 1800]}
                sizes="(max-width: 760px) 100vw, 66vw"
                alt={photo.alt}
                loading={index < 2 ? "eager" : "lazy"}
              />
            </button>
            <figcaption><span>{photo.location ?? "Norway"}</span>{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <section class="contact-sheet-empty" aria-labelledby="edit-title">
        <div class="film-frame"><span>01</span><i></i><small>EDIT IN PROGRESS</small></div>
        <div class="film-frame"><span>02</span><i></i><small>OSLO</small></div>
        <div class="film-frame"><span>03</span><i></i><small>BODØ</small></div>
        <div class="film-frame"><span>04</span><i></i><small>LOFOTEN</small></div>
        <div class="edit-note"><p class="eyebrow">The edit</p><h2 id="edit-title">Twelve to twenty frames.<br />Only the keepers.</h2><p>The gallery structure is ready; the final photographs, captions, and locations will be added after the originals have been selected and stripped of private metadata.</p></div>
      </section>
    )}

    <dialog class="lightbox" data-lightbox aria-label="Photograph viewer">
      <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close photograph">×</button>
      <button class="lightbox-step lightbox-prev" type="button" data-lightbox-prev aria-label="Previous photograph">←</button>
      <figure><img data-lightbox-image src="" alt="" /><figcaption data-lightbox-caption></figcaption></figure>
      <button class="lightbox-step lightbox-next" type="button" data-lightbox-next aria-label="Next photograph">→</button>
    </dialog>

    <aside class="truth-note photo-note"><span aria-hidden="true">◌</span><div><strong>Privacy is part of the edit.</strong><p>Public derivatives contain no embedded GPS data. Locations are added by hand only when they contribute to the story.</p></div></aside>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const triggers = [...document.querySelectorAll<HTMLButtonElement>("[data-photo]")];
  const image = document.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const caption = document.querySelector<HTMLElement>("[data-lightbox-caption]");
  let active = 0;

  const show = (index: number) => {
    if (!dialog || !image || !caption || triggers.length === 0) return;
    active = (index + triggers.length) % triggers.length;
    const source = triggers[active].querySelector<HTMLImageElement>("img");
    const text = triggers[active].closest("figure")?.querySelector("figcaption");
    if (!source) return;
    image.src = source.currentSrc || source.src;
    image.alt = source.alt;
    caption.textContent = text?.textContent?.trim() ?? "";
    if (!dialog.open) dialog.showModal();
  };

  triggers.forEach((trigger, index) => trigger.addEventListener("click", () => show(index)));
  document.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog?.close());
  document.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => show(active - 1));
  document.querySelector("[data-lightbox-next]")?.addEventListener("click", () => show(active + 1));
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") { event.preventDefault(); show(active - 1); }
    if (event.key === "ArrowRight") { event.preventDefault(); show(active + 1); }
  });
</script>
