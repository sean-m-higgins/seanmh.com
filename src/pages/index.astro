---
// The Nexus — the meta-version. A 3D entry world where each portfolio version
// is a portal. This page is intentionally standalone (no Navigation/Footer,
// no VersionSwitcher): the portals ARE the switcher.
import "../styles/global.css";
import { site } from "../content/site.ts";
import { VERSIONS } from "../content/versions.ts";

const title = "Sean Higgins — The Nexus";
const description =
  "One portfolio, parallel universes — each living on its own git branch. Choose yours.";

const portals = VERSIONS;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="nexus fixed inset-0 overflow-hidden bg-[#05060e] font-sans text-neutral-100 antialiased">
    <div id="nexus-scene" class="absolute inset-0" aria-hidden="true"></div>

    <header class="pointer-events-none absolute inset-x-0 top-0 z-10 flex flex-col items-center gap-2 px-6 pt-10 text-center sm:pt-14">
      <p class="nexus-fade font-mono text-[0.7rem] uppercase tracking-[0.35em] text-neutral-500">
        seanmh.com / the nexus
      </p>
      <h1 class="nexus-fade text-2xl font-semibold tracking-tight text-neutral-100 sm:text-3xl" style="animation-delay: 0.15s">
        Choose your universe.
      </h1>
      <p class="nexus-fade max-w-md text-sm text-neutral-400" style="animation-delay: 0.3s">
        One portfolio by {site.name}, parallel builds — each living on its own git branch.
      </p>
    </header>

    <!-- Floating labels: real links, positioned under each portal by the scene. -->
    <div id="nexus-labels">
      {
        portals.map((p, index) => (
          <a
            href={p.href}
            data-version={p.name}
            data-active={index === 0 ? "true" : undefined}
            tabindex={index === 0 ? 0 : -1}
            aria-hidden={index === 0 ? undefined : "true"}
            class="portal-label"
            style={`--portal-color: ${p.color}`}
          >
            <span class="portal-label-name">
              <span aria-hidden="true">{p.glyph}</span> {p.label} <span class="sr-only">version —</span>
              <span class="portal-label-blurb">{p.blurb}</span>
            </span>
            <span class="portal-label-branch">{p.branch}</span>
          </a>
        ))
      }
    </div>

    <div id="nexus-orbit-controls" class="nexus-orbit-controls" aria-label="Universe carousel controls">
      <button id="nexus-orbit-prev" class="nexus-orbit-control nexus-orbit-prev" type="button" aria-label="Previous universe">
        <span aria-hidden="true">‹</span>
        <small>previous</small>
      </button>
      <button id="nexus-orbit-next" class="nexus-orbit-control nexus-orbit-next" type="button" aria-label="Next universe">
        <span aria-hidden="true">›</span>
        <small>next</small>
      </button>
    </div>
    <p id="nexus-orbit-status" class="sr-only" aria-live="polite">
      {portals[0]?.label}, universe 1 of {portals.length}
    </p>

    <footer class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex flex-col items-center justify-center gap-2 px-6 pb-6">
      <p class="nexus-fade font-mono text-[0.7rem] tracking-[0.2em] text-neutral-600" style="animation-delay: 0.6s">
        <span id="nexus-look-hint">drag to spin · arrows to step</span> · enter the front portal
      </p>
      <button
        id="nexus-tilt-permission"
        type="button"
        hidden
        class="nexus-fade pointer-events-auto rounded-full border border-neutral-700 bg-[#0b0d18]/90 px-3 py-1.5 font-mono text-[0.65rem] tracking-[0.12em] text-neutral-300 transition-colors hover:border-neutral-500 hover:text-neutral-100 disabled:cursor-wait disabled:opacity-50"
        style="animation-delay: 0.7s"
      >
        enable phone tilt
      </button>
    </footer>

    <!-- Shown when WebGL is unavailable. -->
    <section id="nexus-fallback" hidden class="absolute inset-0 z-20 flex items-center justify-center bg-[#05060e] px-6">
      <div class="w-full max-w-sm">
        <p class="mb-6 text-sm text-neutral-400">
          This browser can't render the 3D nexus. Step through a door the classic way:
        </p>
        <ul class="flex flex-col gap-3">
          {
            portals.map((p) => (
              <li>
                <a
                  href={p.href}
                  class="flex items-baseline justify-between rounded-lg border border-neutral-800 px-4 py-3 font-mono text-sm text-neutral-200 transition-colors hover:border-neutral-600"
                  style={`--portal-color: ${p.color}`}
                >
                  <span>
                    <span style={`color: ${p.color}`} aria-hidden="true">{p.glyph}</span> {p.label} — {p.blurb}
                  </span>
                  <span class="text-xs text-neutral-500">{p.branch}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <noscript>
      <section class="absolute inset-0 z-30 flex items-center justify-center bg-[#05060e] px-6">
        <ul class="flex flex-col gap-4 font-mono text-sm">
          {
            portals.map((p) => (
              <li>
                <a href={p.href} class="underline">
                  {p.glyph} {p.label} — {p.blurb} ({p.branch})
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </noscript>

    <!-- Entry veil: floods the screen with the chosen universe's color. -->
    <div
      id="nexus-veil"
      class="pointer-events-none absolute inset-0 z-40 opacity-0"
      aria-hidden="true"
    >
    </div>

    <script src="../scripts/nexus.ts"></script>

    <style>
      .portal-label {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
        font-family: var(--font-mono);
        text-align: center;
        text-decoration: none;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        will-change: transform;
      }

      .portal-label[data-active="true"] {
        opacity: 1;
        pointer-events: auto;
        /* Opacity-only keyframes: the scene positions labels via inline
           transform every frame, which a transform animation would override. */
        animation: nexus-label-fade 0.8s ease-out 0.55s both;
      }

      #nexus-labels[data-spinning] .portal-label {
        pointer-events: none;
      }

      #nexus-labels[data-entering] .portal-label {
        opacity: 0;
      }

      .portal-label-name {
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-neutral-300, #d4d4d4);
        transition: color 0.25s ease;
      }

      .portal-label-blurb {
        display: block;
        margin-top: 0.1rem;
        font-size: 0.68rem;
        font-weight: 400;
        letter-spacing: 0.06em;
        text-transform: none;
        color: #6b7089;
      }

      .portal-label-branch {
        font-size: 0.65rem;
        letter-spacing: 0.04em;
        color: #494e63;
        transition: color 0.25s ease;
      }

      .portal-label:hover .portal-label-name,
      .portal-label:focus-visible .portal-label-name {
        color: var(--portal-color);
      }

      .portal-label:hover .portal-label-branch,
      .portal-label:focus-visible .portal-label-branch {
        color: color-mix(in srgb, var(--portal-color) 60%, transparent);
      }

      .portal-label:focus-visible {
        outline: 2px solid var(--portal-color);
        outline-offset: 6px;
        border-radius: 4px;
      }

      .nexus-fade {
        opacity: 0;
        animation: nexus-fade-in 0.9s ease-out forwards;
      }

      .nexus-orbit-controls {
        position: absolute;
        inset: 0;
        z-index: 15;
        pointer-events: none;
      }

      .nexus-orbit-control {
        position: absolute;
        top: 50%;
        display: flex;
        width: clamp(3.25rem, 5.5vw, 5rem);
        min-height: 5rem;
        padding: 0.75rem 0.4rem;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.1rem;
        border: 1px solid rgba(125, 136, 174, 0.25);
        border-radius: 999px;
        color: #9ca7ca;
        background: rgba(7, 8, 20, 0.48);
        box-shadow: inset 0 0 1.5rem rgba(99, 102, 241, 0.06);
        backdrop-filter: blur(8px);
        pointer-events: auto;
        transform: translateY(-50%);
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, scale 0.2s ease;
      }

      .nexus-orbit-control:hover,
      .nexus-orbit-control:focus-visible {
        color: #e4e8ff;
        border-color: rgba(164, 175, 218, 0.62);
        background: rgba(10, 12, 27, 0.92);
      }

      .nexus-orbit-control:active {
        scale: 0.94;
      }

      .nexus-orbit-control:focus-visible {
        outline: 2px solid #a4afda;
        outline-offset: 4px;
      }

      .nexus-orbit-control span {
        font-family: var(--font-sans);
        font-size: 2.4rem;
        font-weight: 300;
        line-height: 0.75;
      }

      .nexus-orbit-control small {
        font-family: var(--font-mono);
        font-size: 0.54rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .nexus-orbit-prev {
        left: clamp(0.75rem, 2.5vw, 2.5rem);
      }

      .nexus-orbit-next {
        right: clamp(0.75rem, 2.5vw, 2.5rem);
      }

      #nexus-scene canvas {
        cursor: grab;
        touch-action: none;
      }

      body[data-dragging] #nexus-scene canvas {
        cursor: grabbing !important;
      }

      #nexus-veil {
        transition: opacity 0.1s linear;
      }

      header,
      footer {
        transition: opacity 0.35s ease;
      }

      body[data-entering] header,
      body[data-entering] footer {
        opacity: 0;
      }

      @keyframes nexus-fade-in {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes nexus-label-fade {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      @media (max-width: 640px) {
        .portal-label-name {
          font-size: 0.7rem;
        }
        .portal-label-blurb {
          font-size: 0.62rem;
        }
        .portal-label-branch {
          font-size: 0.6rem;
        }
        .nexus-orbit-control {
          width: 3rem;
          min-height: 3rem;
          padding: 0.5rem;
        }
        .nexus-orbit-control span {
          font-size: 2rem;
        }
        .nexus-orbit-control small {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .nexus-fade {
          animation: none;
          opacity: 1;
          transform: none;
        }
        .portal-label[data-active="true"] {
          animation: none;
          opacity: 1;
        }
        .nexus-orbit-control {
          transition: none;
        }
      }
    </style>
  </body>
</html>
