---
import TheaterSwitch from "../components/TheaterSwitch.astro";
import { films, filmPath, formatDuration } from "../content/films";
import FilmLayout from "../layouts/FilmLayout.astro";

const description = "From life: four short films made entirely in code from Sean Higgins’s own photographs and videos.";
---

<FilmLayout title="from life — films by Sean Higgins" description={description} canonicalPath="/films/" image="/films/grain-poster.webp" skipLabel="Skip to the collection">
  <div class="collection-page">
    <header class="museum-masthead">
      <a class="wordmark" href="/films/" aria-current="page"><span>from life</span><small>films by Sean Higgins</small></a>
      <nav aria-label="Collection links">
        <TheaterSwitch />
        <a href="/"><span class="portfolio-long">Sean’s </span>portfolio ↗</a>
      </nav>
    </header>
    <main id="film-work" class="collection-main">
      <header class="collection-intro">
        <p class="section-kicker">An exhibition in four short films</p>
        <div class="collection-title-row">
          <h1>from <em>life.</em></h1>
          <p>Things made by hand.<br />Stories drawn from them.</p>
        </div>
      </header>
      <div class="collection-rule"><span>Selected films / 01—04</span><span>Silent · 2026</span></div>
      <ol class="collection-films" aria-label="Choose a film">
        {films.map((film, i) => (
          <li>
            <a class="collection-film" href={filmPath(film.slug)}>
              <div class="collection-image">
                <img src={`/films/${film.slug}-poster.webp`} alt={`A still from ${film.title}`} width="1080" height="1080" />
                <span class="collection-play" aria-hidden="true">↗</span>
              </div>
              <div class="collection-film-meta"><span>0{i + 1} / {film.kind === "story" ? "A story" : film.kind === "portrait" ? "A portrait" : "The making"}</span><span>{formatDuration(film.duration)}</span></div>
              <div class="collection-film-title"><h2>{film.title}</h2><span class="collection-watch">Watch film ↗</span></div>
              <p>{film.subject}.</p>
            </a>
          </li>
        ))}
      </ol>
    </main>
    <footer class="museum-footer"><p>© {new Date().getFullYear()} Sean Higgins</p><p>Three projects, one cat. Four films.</p></footer>
  </div>
</FilmLayout>
