---
// 404: a failed cd, printed inside the same terminal window as everything
// else. The root listing is the one the live prompt prints for `ls ~`
// (listRoot in index.astro), so the page points at paths that really exist.
//
// The requested path is filled in at runtime — this page answers every unknown
// URL, so the build cannot know it. Without JS the command still reads as a
// shell line and the error is still a complete sentence.
import TerminalLayout from "../layouts/TerminalLayout.astro";
import TerminalBlock from "../components/TerminalBlock.astro";

export const prerender = true;
---

<TerminalLayout
  title="404 — No such file or directory"
  description="That path doesn't exist on this machine."
>
  <div>
    <TerminalBlock command="cd $REQUESTED_PATH">
      <p class="text-red-600 dark:text-red-400">
        cd: no such file or directory<span data-path></span>
      </p>
    </TerminalBlock>

    <TerminalBlock command="ls ~">
      <p>about.txt&nbsp;&nbsp;resume.md&nbsp;&nbsp;contact.txt</p>
      <p>projects/&nbsp;&nbsp;experience/&nbsp;&nbsp;education/</p>
      <p>git/&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;versions/&nbsp;&nbsp;&nbsp;&nbsp;help</p>
    </TerminalBlock>

    <div class="terminal-block mt-2">
      <a
        href="/"
        class="inline-flex items-baseline gap-2 text-neutral-800 hover:underline dark:text-neutral-200"
      >
        <span class="text-green-500 dark:text-green-400">$</span>
        <span>cd ~</span>
        <span class="cursor" aria-hidden="true"></span>
      </a>
    </div>
  </div>

  <style>
    .cursor {
      display: inline-block;
      width: 0.55em;
      height: 1.1em;
      translate: 0 0.2em;
      background: currentColor;
    }
    @media (prefers-reduced-motion: no-preference) {
      .cursor {
        animation: cursor-blink 1.1s step-end infinite;
      }
    }
    @keyframes cursor-blink {
      50% {
        opacity: 0;
      }
    }
  </style>

  <script>
    // The typed-command animation on the index page reveals these; this page
    // has no typing sequence, so make sure they are visible on their own.
    for (const el of document.querySelectorAll<HTMLElement>(".typed-command")) {
      el.style.visibility = "visible";
    }
    const path = document.querySelector<HTMLElement>("[data-path]");
    if (path) path.textContent = `: ${window.location.pathname}`;
    const command = document.querySelector<HTMLElement>(".typed-command");
    if (command) command.textContent = `cd ${window.location.pathname}`;
  </script>
</TerminalLayout>
