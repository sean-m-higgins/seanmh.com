---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="System not found — Blueprint"
  description="This system coordinate does not exist."
  error
>
  <main id="main-content" class="error-page">
    <p class="eyebrow">ERR / 404</p>
    <h1>That coordinate is outside the system.</h1>
    <p>The blueprint is intact. This particular route is not.</p>
    <div class="error-actions">
      <a class="button button-primary" href="/systems/">Return to Blueprint</a>
      <a class="button" href="/?v=a-scroll">Open the portfolio</a>
    </div>
  </main>
</BaseLayout>
