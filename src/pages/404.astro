---
// 404: an off-map coordinate. The hero's constellation field carries the page
// — nodes drift, link to the cursor, and scatter in a shockwave on click — and
// the 404 itself drifts apart above it, the three digits pulling away from
// each other on slightly different cycles.
//
// Progressive enhancement: the constellation and the coordinate readout are
// both JS-only; without a script this is a plain 404 with copy and a way back.
// Reduced motion drops the field entirely (the component bails) and holds the
// digits still.
import BaseLayout from "../layouts/BaseLayout.astro";
import Constellation from "../components/Constellation.astro";
---

<BaseLayout
  title="404 — Off the map"
  description="There's no page at these coordinates."
>
  <section
    class="relative isolate flex min-h-screen items-center justify-center overflow-hidden px-6 max-md:min-h-svh"
  >
    <Constellation />
    <!-- Same gradient mesh as the hero, so a dead URL still feels like the
         same room. -->
    <div
      class="absolute -inset-[10%] -z-10 bg-[radial-gradient(ellipse_at_top_right,_rgba(99,102,241,0.15),_transparent_50%)]"
    >
    </div>
    <div
      class="absolute -inset-[10%] -z-10 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(99,102,241,0.1),_transparent_50%)]"
    >
    </div>

    <div class="mx-auto w-full max-w-2xl text-center">
      <p class="mb-8 font-mono text-xs uppercase tracking-[0.3em] text-accent">
        Uncharted
      </p>

      <h1
        class="drift mb-8 flex justify-center text-[clamp(4.5rem,18vw,11rem)] font-bold leading-none tracking-tight text-neutral-900 dark:text-neutral-100"
      >
        <span>4</span><span>0</span><span>4</span>
      </h1>

      <h2
        class="mb-4 text-2xl font-bold text-neutral-900 dark:text-neutral-100 sm:text-3xl"
      >
        You've drifted off the map.
      </h2>
      <p class="mx-auto mb-8 max-w-md text-neutral-600 dark:text-neutral-400">
        There's no page at these coordinates — just the quiet space between the
        sections.
      </p>

      <p class="mb-10 font-handwriting text-2xl text-accent">
        everything real is back home
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-block rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white transition-all hover:bg-accent-light hover:shadow-lg hover:shadow-accent/25"
          data-magnetic
        >
          Take me back
        </a>
        <a
          href="/#experience"
          class="px-2 py-3 text-sm font-medium text-neutral-500 underline-offset-4 transition-colors hover:text-accent hover:underline dark:text-neutral-500 dark:hover:text-accent-light"
        >
          See the work
        </a>
      </div>

      <p
        class="mt-12 hidden font-mono text-[10px] uppercase tracking-[0.25em] text-neutral-400 dark:text-neutral-600"
        data-coordinate
      >
      </p>
    </div>
  </section>

  <style>
    /* The digits pull apart on their own cycles — the 404 slowly coming
       untethered rather than sitting still. */
    @media (prefers-reduced-motion: no-preference) {
      .drift span {
        display: inline-block;
        animation: drift 9s ease-in-out infinite alternate;
      }
      .drift span:nth-child(1) {
        animation-duration: 11s;
      }
      .drift span:nth-child(2) {
        animation-delay: -3s;
        animation-duration: 8s;
      }
      .drift span:nth-child(3) {
        animation-delay: -6s;
        animation-duration: 10s;
      }
    }

    @keyframes drift {
      from {
        transform: translate(-7px, 4px) rotate(-1.2deg);
      }
      to {
        transform: translate(7px, -4px) rotate(1.2deg);
      }
    }
  </style>

  <script>
    // The path that missed, shown as the coordinate you wandered to. Read at
    // runtime, not build time: this page is served for every unknown URL.
    const readout = document.querySelector<HTMLElement>("[data-coordinate]");
    if (readout) {
      const path = window.location.pathname;
      readout.textContent = `Last known coordinate · ${path}`;
      readout.classList.remove("hidden");
    }
  </script>
</BaseLayout>
