---
// Light constellation / particle-network background for the hero: nodes drift
// and link to nearby neighbours, gently link to the cursor on hover, and the
// whole thing fades out as the page scrolls. A click sends a shockwave across
// the field — nodes it sweeps past are kicked outward and flare, then a spring
// hauls them back to where they were drifting. Sits behind the hero content,
// never catches pointer events, and is skipped entirely for reduced motion.
---

<canvas
  data-constellation
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 -z-10 h-full w-full"></canvas>

<script>
  import { onTap } from "../scripts/tap";

  function setupConstellation() {
    const candidate = document.querySelector("[data-constellation]");
    if (!(candidate instanceof HTMLCanvasElement)) return;
    if (candidate.dataset.on) return; // guard against double-init
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const context = candidate.getContext("2d");
    if (!context) return;

    const canvas: HTMLCanvasElement = candidate;
    const ctx: CanvasRenderingContext2D = context;
    canvas.dataset.on = "1";

    const LINK = 130;
    const MOUSE = 170;

    // Click shockwave. The front expands at WAVE_SPEED px/frame and only
    // pushes nodes within WAVE_BAND of it, so the impulse reads as a ring
    // crossing the field rather than everything moving at once.
    const WAVE_SPEED = 6.4;
    const WAVE_BAND = 52;
    const WAVE_FORCE = 3.9;
    const WAVE_DECAY = 0.008;
    const MAX_WAVES = 4;
    const IMPULSE_DAMP = 0.94;
    const HEAT_DECAY = 0.94;
    // Spring that pulls a node back to its home after a kick. Paired with
    // IMPULSE_DAMP this is underdamped, so the field overshoots once and
    // settles rather than creeping back — the recoil is the point.
    const SPRING = 0.012;
    // The epicentre bloom is a separate, much faster decay than the wave
    // itself — it reads as the strike, not the travelling front.
    const FLASH_DECAY = 0.055;
    const FLASH_RADIUS = 130;
    // The visible front is a soft band, not a drawn circle: a bright crest
    // with a short sharp lead ahead of it and a long soft wake behind. The
    // asymmetry is what sells the direction of travel — a symmetric band just
    // reads as a ring sitting there getting bigger.
    const WAVE_LEAD = 11;
    const WAVE_TAIL = 48;
    // The band widens as the front expands, the way a real one loses
    // definition with distance.
    const WAVE_GROWTH = 900;
    // ...and dims, since the same energy is spread around a longer
    // circumference. Keeps the strike punchy without a huge ring glaring.
    const WAVE_FALLOFF = 420;

    let w = 0;
    let h = 0;
    let dpr = 1;
    // hx/hy is the node's home, drifting across the canvas at vx/vy. The node
    // itself hangs off that home on a spring: ix/iy is the transient kick a
    // shockwave adds, which the spring and damping work back off. heat drives
    // the brief brightening.
    let particles: {
      x: number;
      y: number;
      hx: number;
      hy: number;
      vx: number;
      vy: number;
      ix: number;
      iy: number;
      heat: number;
    }[] = [];
    let waves: {
      x: number;
      y: number;
      r: number;
      life: number;
      flash: number;
    }[] = [];
    let raf = 0;
    let running = false;
    const mouse = { x: -9999, y: -9999, active: false };

    function resize() {
      const r = canvas.getBoundingClientRect();
      const nextW = r.width;
      const nextH = r.height;
      const nextDpr = Math.min(window.devicePixelRatio || 1, 2);

      // Mobile browsers fire resize events while their address bar collapses
      // during a scroll. Rebuilding the particle array here made the whole
      // constellation jump to new random positions even when its CSS size had
      // not changed. Ignore no-op resizes and preserve the existing field when
      // the canvas genuinely changes size.
      if (
        Math.abs(nextW - w) < 0.5 &&
        Math.abs(nextH - h) < 0.5 &&
        nextDpr === dpr
      )
        return;

      const previousW = w;
      w = nextW;
      h = nextH;
      dpr = nextDpr;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // A width change is a real layout change (usually rotation), so keep the
      // composition proportional. Height-only changes are commonly mobile UI
      // chrome moving; leave visible particles where they are and only bring
      // particles that fell outside the shorter canvas back to its edge.
      if (previousW > 0 && Math.abs(previousW - w) >= 0.5) {
        const scaleX = w / previousW;
        for (const p of particles) {
          p.x *= scaleX;
          p.hx *= scaleX;
        }
      }
      for (const p of particles) {
        p.x = Math.max(0, Math.min(w, p.x));
        p.y = Math.max(0, Math.min(h, p.y));
        p.hx = Math.max(0, Math.min(w, p.hx));
        p.hy = Math.max(0, Math.min(h, p.hy));
      }

      const count = Math.min(72, Math.max(24, Math.round((w * h) / 16000)));
      while (particles.length < count) {
        const x = Math.random() * w;
        const y = Math.random() * h;
        particles.push({
          x,
          y,
          hx: x,
          hy: y,
          vx: (Math.random() - 0.5) * 0.28,
          vy: (Math.random() - 0.5) * 0.28,
          ix: 0,
          iy: 0,
          heat: 0,
        });
      }
      if (particles.length > count) particles.length = count;
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      const dark = document.documentElement.classList.contains("dark");
      const rgb = dark ? "129,140,248" : "99,102,241";
      // Flare colour has to move in opposite directions per theme to stay
      // visible: brighten toward white on the dark ground, deepen toward
      // indigo on the light one.
      const hot = dark ? "224,231,255" : "67,56,202";

      // Advance the shockwaves once per frame, retiring spent ones.
      for (let i = waves.length - 1; i >= 0; i--) {
        const wave = waves[i];
        wave.r += WAVE_SPEED;
        wave.life -= WAVE_DECAY;
        if (wave.flash > 0) wave.flash -= FLASH_DECAY;
        if (wave.life <= 0) waves.splice(i, 1);
      }

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        // The home keeps drifting and bouncing off the edges exactly as the
        // node used to; only the home is clamped, so a node knocked past the
        // edge is pulled back in rather than pinned to it.
        p.hx += p.vx;
        p.hy += p.vy;
        if (p.hx < 0 || p.hx > w) {
          p.vx *= -1;
          p.hx = Math.max(0, Math.min(w, p.hx));
        }
        if (p.hy < 0 || p.hy > h) {
          p.vy *= -1;
          p.hy = Math.max(0, Math.min(h, p.hy));
        }

        for (let k = 0; k < waves.length; k++) {
          const wave = waves[k];
          const wdx = p.x - wave.x;
          const wdy = p.y - wave.y;
          const wd = Math.sqrt(wdx * wdx + wdy * wdy) || 1;
          const band = Math.abs(wd - wave.r);
          if (band < WAVE_BAND) {
            const amp = (1 - band / WAVE_BAND) * wave.life;
            p.ix += (wdx / wd) * amp * WAVE_FORCE;
            p.iy += (wdy / wd) * amp * WAVE_FORCE;
            if (amp > p.heat) p.heat = amp;
          }
        }
        p.heat *= HEAT_DECAY;

        // Spring back to the home, then integrate. This is what makes the
        // blast recover: the impulse carries a node outward, the restoring
        // force overtakes it, and the field closes the hole it opened.
        p.ix += (p.hx - p.x) * SPRING;
        p.iy += (p.hy - p.y) * SPRING;
        p.ix *= IMPULSE_DAMP;
        p.iy *= IMPULSE_DAMP;
        p.x += p.ix;
        p.y += p.iy;

        if (mouse.active) {
          const dx = mouse.x - p.x;
          const dy = mouse.y - p.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < MOUSE * MOUSE) {
            const d = Math.sqrt(d2) || 1;
            // Drag the home along with the node, otherwise the spring fights
            // the cursor and nodes only lean instead of following it.
            p.x += (dx / d) * 0.12;
            p.y += (dy / d) * 0.12;
            p.hx += (dx / d) * 0.12;
            p.hy += (dy / d) * 0.12;
          }
        }
      }

      for (let i = 0; i < particles.length; i++) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const b = particles[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < LINK * LINK) {
            const prox = 1 - Math.sqrt(d2) / LINK;
            const flare = a.heat > b.heat ? a.heat : b.heat;
            ctx.strokeStyle =
              "rgba(" +
              (flare > 0.2 ? hot : rgb) +
              "," +
              prox * (0.45 + flare * 1.5) +
              ")";
            ctx.lineWidth = 1 + flare * 1.5;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
        if (mouse.active) {
          const dx = a.x - mouse.x;
          const dy = a.y - mouse.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < MOUSE * MOUSE) {
            ctx.strokeStyle =
              "rgba(" + rgb + "," + (1 - Math.sqrt(d2) / MOUSE) * 0.55 + ")";
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(mouse.x, mouse.y);
            ctx.stroke();
          }
        }
        ctx.fillStyle =
          "rgba(" + (a.heat > 0.25 ? hot : rgb) + "," + (0.55 + a.heat * 0.45) + ")";
        ctx.beginPath();
        ctx.arc(a.x, a.y, 1.5 + a.heat * 3.4, 0, Math.PI * 2);
        ctx.fill();
      }

      // The front itself — without it the impulse reads as random scatter
      // instead of a wave travelling outward. Two radial fills per wave, and
      // never anything applied to the per-particle passes above.
      for (let i = 0; i < waves.length; i++) {
        const wave = waves[i];

        // Epicentre bloom: the strike, gone long before the front is.
        if (wave.flash > 0) {
          const bloom = ctx.createRadialGradient(
            wave.x,
            wave.y,
            0,
            wave.x,
            wave.y,
            FLASH_RADIUS
          );
          bloom.addColorStop(0, "rgba(" + hot + "," + wave.flash * 0.32 + ")");
          bloom.addColorStop(1, "rgba(" + hot + ",0)");
          ctx.fillStyle = bloom;
          ctx.beginPath();
          ctx.arc(wave.x, wave.y, FLASH_RADIUS, 0, Math.PI * 2);
          ctx.fill();
        }

        // A gradient band rather than a stroked circle: a bright crest only a
        // few pixels thick, a long faint wake dragging behind it, and a quick
        // fade off the leading edge.
        const grow = 1 + wave.r / WAVE_GROWTH;
        const lead = WAVE_LEAD * grow;
        const tail = WAVE_TAIL * grow;
        const outer = wave.r + lead;
        const inner = Math.max(0, wave.r - tail);
        const span = outer - inner;
        const amp = wave.life / (1 + wave.r / WAVE_FALLOFF);

        // The profile is written as pixel offsets from the crest and converted
        // to stops, so it keeps the shape it was tuned to as the band widens.
        // `at` is monotonic in d, which is what keeps the stops ascending even
        // where the band is cropped against the epicentre.
        const at = (d: number) =>
          Math.min(1, Math.max(0, (wave.r + d - inner) / span));

        const front = ctx.createRadialGradient(
          wave.x,
          wave.y,
          inner,
          wave.x,
          wave.y,
          outer
        );
        front.addColorStop(0, "rgba(" + rgb + ",0)");
        front.addColorStop(at(-tail * 0.55), "rgba(" + rgb + "," + amp * 0.08 + ")");
        front.addColorStop(at(-lead * 1.4), "rgba(" + rgb + "," + amp * 0.34 + ")");
        front.addColorStop(at(-lead * 0.3), "rgba(" + rgb + "," + amp * 0.72 + ")");
        front.addColorStop(at(0), "rgba(" + hot + "," + amp * 0.98 + ")");
        front.addColorStop(at(lead * 0.3), "rgba(" + rgb + "," + amp * 0.62 + ")");
        front.addColorStop(at(lead * 0.75), "rgba(" + rgb + "," + amp * 0.2 + ")");
        front.addColorStop(1, "rgba(" + rgb + ",0)");
        ctx.fillStyle = front;
        ctx.beginPath();
        ctx.arc(wave.x, wave.y, outer, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function loop() {
      if (!running) return;
      const sy = window.scrollY || window.pageYOffset || 0;
      const op = Math.max(0, 1 - sy / (h * 0.55));
      canvas.style.opacity = String(op);
      if (op > 0.01) draw();
      raf = requestAnimationFrame(loop);
    }
    function start() {
      if (running) return;
      running = true;
      loop();
    }
    function stop() {
      running = false;
      if (raf) cancelAnimationFrame(raf);
    }

    function onMove(e: PointerEvent) {
      const r = canvas.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      mouse.active = x >= 0 && x <= w && y >= 0 && y <= h;
      mouse.x = x;
      mouse.y = y;
    }
    function onLeave() {
      mouse.active = false;
    }
    // The canvas is pointer-events:none, so the strike is caught on window and
    // converted to canvas space. Anything landing outside the hero is ignored.
    function strike(clientX: number, clientY: number) {
      const r = canvas.getBoundingClientRect();
      const x = clientX - r.left;
      const y = clientY - r.top;
      if (x < 0 || x > w || y < 0 || y > h) return;
      waves.push({ x, y, r: 0, life: 1, flash: 1 });
      if (waves.length > MAX_WAVES) waves.shift();
    }
    function onDown(e: PointerEvent) {
      if (!e.isPrimary || e.button !== 0) return;
      strike(e.clientX, e.clientY);
    }

    resize();
    window.addEventListener("resize", resize);
    // Touch pointermove events are scroll gestures, not hover. Treating them
    // as a cursor made particles chase a finger while the page itself moved.
    const hasHoverPointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    if (hasHoverPointer) {
      window.addEventListener("pointermove", onMove, { passive: true });
      window.addEventListener("pointerleave", onLeave);
      window.addEventListener("pointerdown", onDown, { passive: true });
    }
    // Touch gets the shockwave too — on a tap rather than a raw pointerdown,
    // which would fire at the start of every scroll swipe. There is no touch
    // equivalent of the cursor link above, so that stays hover-only.
    const teardownTap = hasHoverPointer ? null : onTap(window, strike);

    // Only animate while the hero is in view.
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) en.isIntersecting ? start() : stop();
      },
      { threshold: 0 }
    );
    io.observe(canvas);

    document.addEventListener(
      "astro:before-swap",
      () => {
        stop();
        io.disconnect();
        window.removeEventListener("resize", resize);
        window.removeEventListener("pointermove", onMove);
        window.removeEventListener("pointerleave", onLeave);
        window.removeEventListener("pointerdown", onDown);
        teardownTap?.();
        waves = [];
        delete canvas.dataset.on;
      },
      { once: true }
    );
  }

  setupConstellation();
  document.addEventListener("astro:page-load", setupConstellation);
</script>
