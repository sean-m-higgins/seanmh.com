---
import SectionHeading from "./SectionHeading.astro";
import ExperienceItem from "./ExperienceItem.astro";
import QuoteNote from "./QuoteNote.astro";
import { Image } from "astro:assets";
import sunnyRed from "../assets/images/sunny-red.png";
import { experience } from "../content/experience";
import { testimonials } from "../content/about";

const work = experience.filter((e) => e.type === "work");
const education = experience.filter((e) => e.type === "education");
---

<section id="experience" class="pt-24 pb-8">
  <div class="mx-auto max-w-4xl px-6">
    <SectionHeading title="Experience" />
    <div class="grid gap-16 md:grid-cols-2">
      <div>
        <h3
          class="mb-6 font-mono text-xs font-medium uppercase tracking-widest text-neutral-500"
        >
          Work
        </h3>
        {work.map((entry) => <ExperienceItem entry={entry} />)}
      </div>
      <div>
        <h3
          class="mb-6 font-mono text-xs font-medium uppercase tracking-widest text-neutral-500"
        >
          Education
        </h3>
        {education.map((entry) => <ExperienceItem entry={entry} />)}
        <!-- Fills the white space below Education (Work runs longer). -->
        <QuoteNote {...testimonials[0]} align="right" class="mt-16" />
        <QuoteNote {...testimonials[4]} align="left" class="mt-20" />
      </div>
    </div>
    <!-- Decorative: a slowly rotating Sunny, centered below the columns. -->
    <Image
      src={sunnyRed}
      alt=""
      aria-hidden="true"
      width={400}
      data-sunny-spin
      class="pointer-events-none mx-auto mt-8 w-48"
    />
  </div>
</section>
