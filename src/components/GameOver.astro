<div id="screen-over" class="fixed inset-0 z-30 hidden cursor-pointer flex-col items-center overflow-y-auto bg-[#17130f]/92 px-6 pt-[max(2.5rem,env(safe-area-inset-top))] pb-[max(4.5rem,env(safe-area-inset-bottom))] backdrop-blur-sm">
  <div class="my-auto flex w-full max-w-xl flex-col items-center">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-[#a99d89]">final bell</p>
    <p id="over-score" class="mt-2 font-mono text-6xl font-black tabular-nums sm:text-7xl">0</p>
    <p id="over-delta" class="mt-2 font-mono text-sm text-[#b9ad99]"></p>

    <div class="mt-7 grid grid-cols-3 gap-x-8 text-center sm:gap-x-14">
      <div><p id="over-counters" class="font-mono text-xl font-bold">0</p><p class="stat-label">counters</p></div>
      <div><p id="over-hits" class="font-mono text-xl font-bold">0</p><p class="stat-label">hits taken</p></div>
      <div><p id="over-chain" class="font-mono text-xl font-bold">0</p><p class="stat-label">best chain</p></div>
    </div>

    <div id="over-lb" class="mt-7 hidden w-72 cursor-default">
      <p class="text-center font-mono text-[0.62rem] uppercase tracking-[0.25em] text-[#a99d89]">global top 10</p>
      <ol id="lb-list" class="mt-2 space-y-0.5 font-mono text-sm text-[#d8ccb8]"></ol>
      <form id="lb-form" class="mt-3 hidden items-center justify-center gap-2">
        <label for="lb-initials" class="sr-only">Your initials</label>
        <input id="lb-initials" maxlength="3" autocomplete="off" spellcheck="false" placeholder="AAA" class="w-20 border-2 border-[#776c5e] bg-[#211c17] px-3 py-2 text-center font-mono uppercase tracking-[0.25em] text-[#f2e8d5] outline-none focus:border-accent" />
        <button type="submit" class="cursor-pointer border-2 border-accent bg-accent/20 px-4 py-2 font-mono text-sm font-bold text-[#f2e8d5] hover:bg-accent/40">CLAIM SPOT</button>
      </form>
      <p id="lb-status" class="mt-2 hidden text-center font-mono text-xs text-[#a99d89]"></p>
    </div>

    <button id="over-restart" type="button" class="mt-7 cursor-pointer border-2 border-[#f2e8d5] bg-accent px-8 py-3 font-black uppercase tracking-[0.12em] text-[#17130f] shadow-[6px_6px_0_#f2e8d5] transition hover:-translate-y-0.5">Answer the bell</button>
    <p class="mt-3 font-mono text-xs text-[#a99d89]"><kbd class="border border-[#776c5e] px-1.5">R</kbd> — or tap the backdrop</p>

    <div class="mt-7 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm text-[#928674]">
      <a href="/?v=d-3d-game" class="underline decoration-[#655c50] underline-offset-4 hover:text-accent">play the 3D halfpipe</a>
      <span aria-hidden="true">·</span>
      <a href="/?v=nexus" class="underline decoration-[#655c50] underline-offset-4 hover:text-accent">back to the nexus</a>
    </div>
  </div>
</div>

<style is:global>
  .stat-label { margin-top: 0.15rem; font-family: var(--font-mono); font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.16em; color: #a99d89; }
  .over-delta--best { color: #ffd166; text-shadow: 0 0 14px rgb(255 209 102 / 0.45); }
</style>
