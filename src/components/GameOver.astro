---
// Run summary: score, delta to the personal best, stats, instant retry.
---

<div
  id="screen-over"
  class="fixed inset-0 z-30 hidden cursor-pointer flex-col items-center justify-center bg-[#0b0d1a]/75 px-6 backdrop-blur-sm"
>
  <p class="font-mono text-xs uppercase tracking-[0.3em] text-neutral-500">run over</p>
  <p id="over-score" class="mt-3 font-mono text-6xl font-bold tabular-nums sm:text-7xl">0</p>
  <p id="over-delta" class="over-delta mt-3 font-mono text-sm text-neutral-400"></p>

  <div class="mt-8 grid grid-cols-2 gap-x-10 gap-y-4 text-center sm:grid-cols-4">
    <div>
      <p id="over-landings" class="font-mono text-xl font-bold">0</p>
      <p class="mt-0.5 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-neutral-500">landings</p>
    </div>
    <div>
      <p id="over-bails" class="font-mono text-xl font-bold">0</p>
      <p class="mt-0.5 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-neutral-500">bails</p>
    </div>
    <div>
      <p id="over-trick" class="font-mono text-xl font-bold">0</p>
      <p class="mt-0.5 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-neutral-500">best trick</p>
    </div>
    <div>
      <p id="over-chain" class="font-mono text-xl font-bold">×1</p>
      <p class="mt-0.5 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-neutral-500">top chain</p>
    </div>
  </div>

  <!-- Global leaderboard (appears only when /api/score is reachable) -->
  <div id="over-lb" class="mt-8 hidden w-72 cursor-default">
    <p class="text-center font-mono text-[0.65rem] uppercase tracking-[0.25em] text-neutral-500">
      global top 10
    </p>
    <ol id="lb-list" class="mt-2 space-y-0.5 font-mono text-sm text-neutral-300"></ol>
    <form id="lb-form" class="mt-3 hidden items-center justify-center gap-2">
      <label for="lb-initials" class="sr-only">Your initials</label>
      <input
        id="lb-initials"
        maxlength="3"
        autocomplete="off"
        spellcheck="false"
        placeholder="AAA"
        class="w-20 rounded-lg border border-neutral-700 bg-neutral-900/80 px-3 py-2 text-center font-mono uppercase tracking-[0.3em] text-neutral-100 outline-none focus:border-accent"
      />
      <button
        type="submit"
        class="cursor-pointer rounded-lg border border-accent/50 bg-accent/20 px-4 py-2 font-mono text-sm font-bold text-accent-light transition hover:bg-accent/35"
      >
        CLAIM SPOT
      </button>
    </form>
    <p id="lb-status" class="mt-2 hidden text-center font-mono text-xs text-neutral-500"></p>
  </div>

  <button
    id="over-restart"
    type="button"
    class="mt-8 cursor-pointer rounded-full bg-accent px-9 py-3 font-bold tracking-wide text-white shadow-[0_0_30px_rgba(99,102,241,0.45)] transition hover:bg-accent-light"
  >
    DROP IN AGAIN
  </button>
  <p class="mt-3 font-mono text-xs text-neutral-500">
    <kbd class="rounded border border-neutral-700 px-1.5">R</kbd> — or tap anywhere
  </p>

  <p class="absolute bottom-5 text-center text-sm text-neutral-500">
    enough shredding?
    <a href="/?v=nexus" class="ml-1 text-neutral-300 underline decoration-neutral-600 underline-offset-4 hover:text-accent">back to the nexus</a>
  </p>
</div>

<style is:global>
  .over-delta--best {
    color: #3ddc84;
    text-shadow: 0 0 16px rgba(61, 220, 132, 0.5);
  }
</style>
