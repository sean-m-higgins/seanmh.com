---
import SectionHeading from "./SectionHeading.astro";
import QuoteNote from "./QuoteNote.astro";
import { Image } from "astro:assets";
import sunnyWall from "../assets/images/sunny-wall.png";
import { differentiators, testimonials } from "../content/about";
---

<section id="highlights" class="relative overflow-hidden py-24">
  <!-- Decorative: Sunny sits at the left edge of the page (wide screens only). -->
  <Image
    src={sunnyWall}
    alt=""
    aria-hidden="true"
    width={320}
    class="pointer-events-none absolute bottom-0 left-0 hidden w-40 xl:block"
  />
  <div class="relative mx-auto max-w-4xl px-6">
    <SectionHeading title="Highlights" />

    <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2">
      {
        differentiators.map((d, i) => (
          <div data-highlight>
            <span class="font-mono text-sm font-semibold text-accent/60">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-2 text-lg font-bold text-neutral-900 dark:text-neutral-100">
              {d.title}
            </h3>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
              {d.body}
            </p>
          </div>
        ))
      }
      <!-- Fills the empty final grid cell (7 highlights leave one open). -->
      <QuoteNote {...testimonials[2]} align="left" class="self-center" />
    </div>
  </div>
</section>
