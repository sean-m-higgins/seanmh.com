---
import { site } from "../content/site";
import Constellation from "./Constellation.astro";
import { Image } from "astro:assets";
import hibiscus from "../assets/images/hibiscus.png";
---

<section
  class="relative isolate flex min-h-screen items-center justify-center overflow-hidden max-md:min-h-svh"
  data-hero
>
  <Constellation />
  <!-- Gradient mesh background, split into layers so the scroll scene can
       drift them at different rates. Oversized so drifting never exposes an
       edge. -->
  <div
    class="absolute -inset-[10%] -z-10 bg-[radial-gradient(ellipse_at_top_right,_rgba(99,102,241,0.15),_transparent_50%)]"
    data-hero-orb-1
  >
  </div>
  <div
    class="absolute -inset-[10%] -z-10 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(99,102,241,0.1),_transparent_50%)]"
    data-hero-orb-2
  >
  </div>

  <!-- Decorative: a hibiscus bloom leans into the top-right corner, behind
       the content. Sits after the orbs so it paints over them, and the scroll
       scene drifts it as the hero unwinds. -->
  <Image
    src={hibiscus}
    alt=""
    aria-hidden="true"
    width={860}
    data-hero-blossom
    class="pointer-events-none absolute -right-20 top-4 -z-10 w-48 -rotate-12 drop-shadow-xl sm:w-72 lg:-right-28 lg:top-12 lg:w-[23rem]"
  />

  <div class="vt-skip-intro mx-auto w-full max-w-6xl px-6 py-24 text-center">
    <p
      class="mb-4 font-mono text-sm tracking-wider text-accent animate-fade-in"
      data-hero-greeting
    >
      Hello, I'm
    </p>
    <h1
      class="vt-sean-name vt-skip-intro mb-6 text-[clamp(3.5rem,11vw,9rem)] font-bold leading-[0.95] tracking-tight text-neutral-900 dark:text-neutral-100 animate-fade-in [animation-delay:100ms]"
      data-hero-name
    >
      {site.name}
    </h1>
    <p
      class="mb-6 text-xl text-neutral-600 dark:text-neutral-400 sm:text-2xl animate-fade-in [animation-delay:200ms]"
      data-hero-title
    >
      {site.title}
    </p>
    <p
      class="mb-10 text-lg text-neutral-500 dark:text-neutral-500 animate-fade-in [animation-delay:300ms]"
      data-hero-tagline
    >
      {site.tagline}
    </p>
    <a
      href="#contact"
      class="inline-block rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white transition-all hover:bg-accent-light hover:shadow-lg hover:shadow-accent/25 animate-fade-in [animation-delay:400ms]"
      data-hero-cta
    >
      Get in Touch
    </a>
  </div>

  <div
    class="vt-skip-intro absolute bottom-8 left-1/2 -translate-x-1/2 text-center animate-fade-in [animation-delay:600ms]"
    data-hero-cue
    aria-hidden="true"
  >
    <span
      class="font-mono text-[10px] uppercase tracking-[0.3em] text-neutral-400 dark:text-neutral-600"
    >
      Scroll
    </span>
    <span
      class="mx-auto mt-2 block h-10 w-px bg-gradient-to-b from-neutral-400 to-transparent dark:from-neutral-600"
    ></span>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    opacity: 0;
    animation: fade-in 0.6s ease-out forwards;
  }
</style>
