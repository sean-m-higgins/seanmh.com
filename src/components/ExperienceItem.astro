---
import type { ExperienceEntry } from "../content/experience";

interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props;
---

<div class="relative pl-8 pb-10 last:pb-0 group" data-exp-item>
  <!-- Timeline line -->
  <div
    class="absolute left-0 top-1.5 h-full w-px bg-neutral-200 dark:bg-neutral-800 group-last:hidden"
    data-exp-line
  >
  </div>
  <!-- Timeline dot -->
  <div
    class="absolute left-[-4px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-accent bg-white dark:bg-[#0a0a0a]"
    data-exp-dot
  >
  </div>

  <div data-exp-content>
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
    <div>
      <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">
        {entry.title}
      </h3>
      <p class="text-sm text-accent">
        {
          entry.url ? (
            <a
              href={entry.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline"
            >
              {entry.organization}
            </a>
          ) : (
            entry.organization
          )
        }
      </p>
    </div>
    <span
      class="shrink-0 font-mono text-xs text-neutral-500 dark:text-neutral-500"
    >
      {entry.dates}
    </span>
  </div>
  <ul
    class="mt-3 list-disc space-y-2 pl-4 text-sm text-neutral-600 marker:text-accent/50 dark:text-neutral-400"
  >
    {/* Highlights may carry inline <b class="stat"> emphasis on figures. The
        content is authored in src/content, never user input. */}
    {entry.highlights.map((point) => <li set:html={point} />)}
  </ul>
  </div>
</div>
