---
import SectionHeading from "./SectionHeading.astro";
import { Image } from "astro:assets";
import headshot from "../assets/images/headshot.jpeg";
import flower from "../assets/images/flower.png";
import orange from "../assets/images/orange.png";
import red from "../assets/images/red.png";
import space from "../assets/images/space.png";
import table from "../assets/images/table.jpeg";
import sunny from "../assets/images/sunny.png";
import sunnyFuzzy from "../assets/images/sunny-fuzzy.png";
import bouquet from "../assets/images/bouquet.png";
import { currentFocus } from "../content/about";
---

<section id="about" class="py-24">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading title="About" />

    <div
      class="mx-auto flex max-w-4xl flex-col items-start gap-8 md:flex-row md:items-center"
    >
      <Image
        src={headshot}
        alt="Sean Higgins"
        width={320}
        height={320}
        class="h-40 w-40 shrink-0 rounded-2xl object-cover"
        data-about-photo
      />
      <p class="text-neutral-600 dark:text-neutral-400" data-about-copy>
        Software engineer with an M.S. in Software Engineering and a B.S. in
        Computer Science from Loyola University Chicago. Currently working on
        a high-performing enterprise platform team building authentication and
        API gateway infrastructure at scale. I enjoy building clean, practical
        software and have experience across front-end, back-end, data
        engineering, and machine learning.
      </p>
    </div>

    <!-- Currently: highlighted callout for the present-day focus -->
    <div
      class="relative mx-auto mt-16 max-w-3xl rounded-r-xl border-l-4 border-accent bg-accent/5 p-6 sm:p-8"
      data-currently
    >
      <!-- Sunny stretches out along the top edge of the callout. -->
      <Image
        src={sunnyFuzzy}
        alt="Sunny the cat, stretched out and lounging"
        width={320}
        data-bloom
        class="pointer-events-none absolute bottom-full -mb-4 right-4 w-28 origin-bottom drop-shadow-lg sm:right-8 sm:w-32"
      />
      <p class="text-xl font-semibold leading-snug text-neutral-900 sm:text-2xl dark:text-neutral-100">
        {currentFocus.lead}
      </p>
      <p class="mt-4 text-neutral-600 dark:text-neutral-400" set:html={currentFocus.scale} />
      <p class="mt-4 text-neutral-600 dark:text-neutral-400">
        {currentFocus.body}
      </p>
    </div>

    <!-- Off the clock: personal paragraph + table flanked by the leaning art
         gallery. Same flanking composition at every breakpoint — on mobile the
         grid goes full-bleed and the paintings shrink and bleed off the screen
         edges (clipped by overflow-hidden), preserving the desktop layout in
         miniature instead of a separate stacked grid. -->
    <div
      class="mt-20 -mx-6 grid grid-cols-[4.5rem_1fr_4.5rem] items-center overflow-hidden lg:mx-0 lg:grid-cols-[1fr_minmax(0,34rem)_1fr] lg:gap-10 lg:overflow-visible"
    >
      <div class="flex flex-col items-end gap-6 lg:items-center lg:gap-10" aria-hidden="true">
        <Image
          src={flower}
          alt=""
          width={300}
          class="h-auto w-36 max-w-none -rotate-3 drop-shadow-xl lg:w-[300px]"
          data-art
          data-art-side="left"
        />
        <Image
          src={orange}
          alt=""
          width={210}
          class="h-auto w-28 max-w-none rotate-2 drop-shadow-xl lg:w-[210px]"
          data-art
          data-art-side="left"
        />
      </div>

      <div class="px-4 lg:px-0">
        <p class="text-center text-neutral-600 dark:text-neutral-400 lg:text-left">
          When I'm not writing code, you can find me in the <span
            data-boxing
            class="whitespace-nowrap"
            ><span
              class="underline decoration-red-500/60 decoration-2 underline-offset-4"
              >boxing ring</span
            > <span data-glove class="inline-block">🥊</span></span
          >, on the mountain snowboarding, enjoying a live concert, or at home
          building furniture and making art. World traveler. Eagle Scout. Cat
          dad to Sunny.
        </p>
        <p class="sr-only">
          Four original paintings by Sean Higgins — a colorful floral field,
          two warm abstract pieces in orange and red, and a dark abstract
          night-sky piece — are shown alongside this text.
        </p>

        <figure class="mx-auto mt-8 max-w-[13rem] sm:max-w-xs lg:max-w-md" data-table-photo>
          <div class="relative mx-auto w-fit">
            <Image
              src={table}
              alt="A coffee table Sean built from oak, with a glass inset top"
              width={480}
              class="mx-auto rounded-xl object-cover shadow-lg"
            />
            <!-- Centered on the tabletop, ahead of Sunny in the DOM so he
                 overlaps the vase, not it him. Centered via auto margins
                 rather than a translate, which GSAP's entrance would clobber. -->
            <Image
              src={bouquet}
              alt=""
              aria-hidden="true"
              width={250}
              data-bloom
              class="pointer-events-none absolute inset-x-0 bottom-[56%] mx-auto w-[21%] origin-bottom drop-shadow-lg"
            />
            <Image
              src={sunny}
              alt="Sunny the cat, lounging on the table"
              width={260}
              class="absolute bottom-[18%] left-1/2 w-[58%] -translate-x-1/2 rotate-1 drop-shadow-xl"
              data-sunny
            />
          </div>
          <figcaption class="mt-2 text-center text-xs text-neutral-500">
            A coffee table, designed and built from scratch. (feat. Sunny)
          </figcaption>
        </figure>
      </div>

      <div class="flex flex-col items-start gap-6 lg:items-center lg:gap-10" aria-hidden="true">
        <Image
          src={space}
          alt=""
          width={300}
          class="h-auto w-36 max-w-none rotate-3 drop-shadow-xl lg:w-[300px]"
          data-art
          data-art-side="right"
        />
        <Image
          src={red}
          alt=""
          width={210}
          class="h-auto w-28 max-w-none -rotate-2 drop-shadow-xl lg:w-[210px]"
          data-art
          data-art-side="right"
        />
      </div>
    </div>
    <p class="mt-4 text-center text-xs text-neutral-500" aria-hidden="true">
      Original paintings by Sean Higgins.
    </p>
  </div>
</section>
