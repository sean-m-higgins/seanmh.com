<div class="mode-options" role="group" aria-label="Viewing mode" hidden>
  <button type="button" class="theater-switch" data-mode="theater" aria-pressed="false">
    <span aria-hidden="true"></span> Theater mode
  </button>
  <button type="button" class="theater-switch" data-mode="dark" aria-pressed="false" hidden>
    <span aria-hidden="true"></span> Dark mode
  </button>
</div>

<script>
  const group = document.querySelector<HTMLElement>(".mode-options")!;
  const buttons = group.querySelectorAll<HTMLButtonElement>("button");
  const darkButton = group.querySelector<HTMLButtonElement>('[data-mode="dark"]')!;
  const system = matchMedia("(prefers-color-scheme: dark)");
  const root = document.documentElement;
  try {
    darkButton.hidden = localStorage.getItem("films-modes-revealed") !== "true";
  } catch { /* Controls still work without storage. */ }

  function update() {
    const mode = root.dataset.filmTheme ?? (system.matches ? "dark" : "light");
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.mode === mode));
    }
  }

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const mode = button.getAttribute("aria-pressed") === "true" ? "light" : button.dataset.mode!;
      root.dataset.filmTheme = mode;
      darkButton.hidden = false;
      update();
      try {
        localStorage.setItem("films-modes-revealed", "true");
        localStorage.setItem("films-theme", mode);
      } catch { /* Keep the choice for this page. */ }
    });
  }

  system.addEventListener("change", update);
  update();
  group.hidden = false;
</script>

<style>
  .mode-options { display: flex; gap: 0.35rem; }
  .mode-options[hidden] { display: none; }
  .theater-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 2rem;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
  }
  .theater-switch[hidden] { display: none; }
  .theater-switch span {
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }
  .theater-switch[aria-pressed="true"] { background: #302a22; color: #f0d8b6; border-color: #70604b; }
  .theater-switch:hover { border-color: currentColor; }
  .theater-switch:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
</style>
