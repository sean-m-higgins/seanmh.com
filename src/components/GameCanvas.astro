---
// The canvas, the WebGL fallback card, and the bootstrap that lazy-loads the
// game bundle behind the start button (the landing shell stays tiny).
---

<canvas id="game-canvas" class="fixed inset-0 h-full w-full touch-none select-none"></canvas>

<div
  id="screen-fallback"
  class="fixed inset-0 z-40 hidden items-center justify-center bg-[#0b0d1a] p-6"
>
  <div class="max-w-md rounded-2xl border border-neutral-800 bg-neutral-950/80 p-8 text-center">
    <p class="font-mono text-sm uppercase tracking-widest text-neutral-500">no WebGL</p>
    <h2 class="mt-3 text-2xl font-bold">This version needs a GPU</h2>
    <p class="mt-3 text-neutral-400">
      The halfpipe couldn't start on this browser. The rest of the site works everywhere —
      pick another version:
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/?v=a-scroll" class="rounded-full border border-neutral-700 px-4 py-1.5 text-sm hover:border-accent hover:text-accent">∿ Scroll</a>
      <a href="/?v=b-card" class="rounded-full border border-neutral-700 px-4 py-1.5 text-sm hover:border-accent hover:text-accent">▣ Card</a>
      <a href="/?v=c-terminal" class="rounded-full border border-neutral-700 px-4 py-1.5 text-sm hover:border-accent hover:text-accent">❯ Terminal</a>
    </div>
  </div>
</div>

<script>
  // Lazy-load the game chunk behind the start button. Hovering or focusing
  // the button warms the import; idle time prefetches it anyway.
  const btn = document.getElementById("start-btn") as HTMLButtonElement | null;
  let mod: Promise<typeof import("../scripts/game/main")> | null = null;
  const load = () => (mod ??= import("../scripts/game/main"));

  if (btn) {
    btn.addEventListener("pointerenter", () => void load(), { once: true });
    btn.addEventListener("focus", () => void load(), { once: true });
    btn.addEventListener("click", async () => {
      btn.disabled = true;
      btn.setAttribute("aria-busy", "true");
      try {
        (await load()).start();
      } catch {
        document.getElementById("screen-start")?.classList.add("hidden");
        const fb = document.getElementById("screen-fallback");
        fb?.classList.remove("hidden");
        fb?.classList.add("flex");
      }
    });
  }
  setTimeout(() => void load(), 3000);
</script>
