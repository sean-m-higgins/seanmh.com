---
// First-load intro: two boxers spar, the left lands a finishing jab, then the
// panel lifts away. Shown on every load; skipped for reduced motion and no-JS
// (see BaseLayout).
import Sparring from "./Sparring.astro";
---

<div
  id="loader"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-white dark:bg-[#0a0a0a]"
  aria-hidden="true"
>
  <Sparring class="w-64 sm:w-72" />
</div>

<style>
  #loader {
    transition: transform 0.6s cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
  }
  #loader.loader-done {
    transform: translateY(-100%);
  }
</style>
