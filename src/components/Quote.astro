---
import QuoteNote from "./QuoteNote.astro";

// Standalone interstitial quote (a note that sits between two sections). The
// negative margins pull it into the neighboring sections' padding so the gap
// reads as an annotation rather than a section break.
interface Props {
  quote: string;
  role: string;
  align?: "left" | "right";
  wide?: boolean;
  // Drop the space below (used when the note should sit flush against the
  // section that follows it).
  flushBottom?: boolean;
}

const { quote, role, align = "left", wide = false, flushBottom = false } = Astro.props;
const wrapper = flushBottom
  ? "mx-auto -mt-10 -mb-20 max-w-6xl px-6 pt-2 pb-0 sm:-mt-12"
  : "mx-auto -my-10 max-w-6xl px-6 py-2 sm:-my-12 sm:py-3";
---

<div class={wrapper}>
  <QuoteNote quote={quote} role={role} align={align} wide={wide} />
</div>
