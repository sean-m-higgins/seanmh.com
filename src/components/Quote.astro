---
interface Props {
  quote: string;
  role: string;
  align?: "left" | "right";
}

const { quote, role, align = "left" } = Astro.props;
const isRight = align === "right";
// Resting tilt via the standalone `rotate` property (inline) so it composes
// with the GSAP transform used by the reveal instead of being overwritten.
const tilt = isRight ? "1.8deg" : "-1.8deg";
---

<div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
  <figure
    data-quote
    style={`rotate: ${tilt}`}
    class:list={[
      "max-w-md",
      isRight ? "ml-auto text-right" : "mr-auto text-left",
    ]}
  >
    <blockquote
      class="font-handwriting text-2xl leading-tight text-accent sm:text-3xl"
    >
      {quote}
    </blockquote>
    <figcaption
      class="mt-2 font-handwriting text-xl text-neutral-500 dark:text-neutral-400"
    >
      — {role}
    </figcaption>
  </figure>
</div>
