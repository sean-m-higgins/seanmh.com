---
import { studyRenderers } from '../lib/studies.mjs';
const studies = [
  { id: 'chain', name: 'Gravity', title: ['Let gravity', 'draw.'], text: 'A hanging chain finds a catenary curve. Invert it and tension becomes a model for compression: a starting point for an arch.', note: 'A form discovered, not imposed.', control: 'sag', label: 'Shape the arch', min: 60, max: 165, value: 110, unit: 'units of sag', caption: 'GRAVITY DRAWS. STRUCTURE ANSWERS.', source: 'https://sagradafamilia.org/en/antoni-gaudi', sourceLabel: 'Gaudí’s way of working' },
  { id: 'branch', name: 'Nature', title: ['Build like', 'a forest.'], text: 'In the Sagrada Família, columns branch into supports for the vaults above. Nature is more than ornament: it suggests how to organize a structure.', note: 'One trunk. Many places to carry the weight.', control: 'branch-angle', label: 'Open the branches', min: 16, max: 42, value: 30, unit: 'degrees', caption: 'A FOREST, TRANSLATED INTO STRUCTURE.', source: 'https://blog.sagradafamilia.org/en/columns-sagrada-familia-geometry-mechanics-materials-stone-forest/', sourceLabel: 'The stone forest' },
  { id: 'ruled', name: 'Geometry', title: ['Straight lines.', 'Living curves.'], text: 'A curved surface need not be made of curved pieces. Gaudí used ruled geometry, including hyperboloids: complex forms that can be traced with straight lines.', note: 'Turn one ring. Watch a waist appear.', control: 'surface-twist', label: 'Twist the surface', min: 20, max: 155, value: 115, unit: 'degrees', caption: 'COMPLEXITY FROM A SIMPLE RULE.', source: 'https://patrimoni.sagradafamilia.org/en/heritageobject/mus8685-hiperboloide-de-la-facana-de-la-gloria/', sourceLabel: 'Gaudí’s hyperboloid model' },
  { id: 'light', name: 'Light', title: ['Give daylight', 'a material.'], text: 'Casa Batlló’s lightwell shifts from darker blue tiles near the top to paler tiles below. Color helps balance the light through the house.', note: 'Move the sun across a little tiled room.', control: 'sun-position', label: 'Move the sunlight', min: 0, max: 100, value: 48, unit: 'percent across the sky', caption: 'LIGHT IS PART OF THE ARCHITECTURE.', source: 'https://www.casabatllo.es/en/news/5-surprising-colors-at-casa-batllo/', sourceLabel: 'Color at Casa Batlló' },
  { id: 'fragments', name: 'Trencadís', title: ['Let the pieces', 'belong.'], text: 'Broken ceramic and glass become a continuous skin. Trencadís lets small, irregular fragments follow curves that a whole tile cannot.', note: 'Change the scale. Keep the whole.', control: 'fragment-size', label: 'Size the fragments', min: 22, max: 65, value: 35, unit: 'units per fragment', caption: 'IRREGULAR PIECES. A SHARED RHYTHM.', source: 'https://www.casabatllo.es/en/news/10-interesting-facts-casa-batllo/', sourceLabel: 'The craft of trencadís' },
] as const;
---
<section id="structure" class="room structure" data-room="02" aria-labelledby="structure-heading">
  <div class="section-heading"><p class="eyebrow">02 / STRUCTURE</p><span class="margin-note">first, find the shape.</span></div>
  <div class="studies-heading"><div><h2 id="structure-heading">Nature has<br/>a few <em>ideas.</em></h2><p>Five ways of thinking with Gaudí.<br/>A small, working sketchbook. Yours to play with.</p></div><p class="study-instruction">SCROLL ACROSS TO EXPLORE <span aria-hidden="true">↔</span></p></div>
  <div class="study-carousel" role="region" aria-roledescription="carousel" aria-label="Five interactive architectural studies">
    <div class="study-navigation enhancement" hidden>
      <div class="study-tabs" role="group" aria-label="Choose a study">{studies.map((s, i) => <button type="button" data-study-go={i} aria-controls={`study-${s.id}`} aria-current={i === 0 ? 'true' : undefined}><span>{String(i + 1).padStart(2, '0')}</span> {s.name}</button>)}</div>
      <div class="study-arrows"><button type="button" data-study-prev aria-label="Previous study" disabled>←</button><span id="study-count" aria-live="polite" aria-atomic="true">01 / 05</span><button type="button" data-study-next aria-label="Next study">→</button></div>
    </div>
    <div class="study-track" id="study-track" role="group" tabindex="0" aria-label="Architectural studies; scroll horizontally or use the arrow keys">
      {studies.map((s, i) => <div class={`study-slide study-${s.id}`} id={`study-${s.id}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} of 5: ${s.name}`}>
        <div class="study-copy"><p class="eyebrow">STUDY {String(i + 1).padStart(2, '0')} / {s.name.toUpperCase()}</p><h3>{s.title[0]}<br/><em>{s.title[1]}</em></h3><p>{s.text}</p><p class="study-note">{s.note}</p><div class="study-control enhancement" hidden><label for={s.control}>{s.label}<output for={s.control} data-study-output={s.id}>{s.value}</output></label><input id={s.control} data-study-input={s.id} data-unit={s.unit} type="range" min={s.min} max={s.max} value={s.value} aria-valuetext={`${s.value} ${s.unit}`}/></div><a class="quiet-link" href={s.source}>{s.sourceLabel} ↗</a></div>
        <figure class="study-drawing"><svg viewBox="0 0 560 550" role="img" aria-labelledby={`study-title-${s.id}`}><title id={`study-title-${s.id}`}>{s.caption}</title><defs><pattern id={`grid-${s.id}`} width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="currentColor" stroke-opacity=".055"/></pattern>{s.id === 'fragments' && <clipPath id="fragments-clip"><rect width="460" height="420" rx="120"/></clipPath>}</defs><path d="M0 0H560V550H0Z" fill={`url(#grid-${s.id})`}/><g data-study-art={s.id} set:html={studyRenderers[s.id](s.value)}/></svg><figcaption>{s.caption}</figcaption></figure>
      </div>)}
    </div>
  </div>
</section>
