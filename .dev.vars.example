# Local API secrets for `npm run preview` (loaded by Wrangler Pages dev).
# Copy to `.dev.vars` (gitignored) and fill in real values.
#
# Production: configure encrypted variables in the seanmh-terminal Cloudflare
# Pages project. Do not commit either value.

# Anthropic API key that powers the `ask` command's /api/ask endpoint.
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret the terminal prompts for before it will call the AI.
# Hand this out to people you want to have access; rotate it here to revoke.
ASK_SECRET=change-me-to-a-long-random-string

# Optional: override the model (defaults to claude-sonnet-5).
# ASK_MODEL=claude-sonnet-5
