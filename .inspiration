--color--cream:  #efefe5   --color--white:  #f4f4ed   --color--black: #111112
--color--grey-1: #ebeee0   --color--grey-2: #c8cbbd
--color--green-off-white-1: #dde1d2   --color--green-off-white-2: #b4b8a5
--color--grey-on-track:     #b9bbad

--text--impact: 7.9375rem  --text--h1: 4rem   --text--h2: 4.5rem
--text--h3: 2rem  --text--h4: 1.5rem  --text--h5: 1.2rem  --text--h6: 1rem
--text--reg: 1.6rem  --text--med: 2.76rem  --text--eyebrow: .578125rem
--radius--small: 1rem  --radius--med: 3rem  --radius--large: 6.25rem
--padding--mini/small/med/large/xlarge: 1 / 2 / 3 / 4 / 5rem
--cubic-default: cubic-bezier(0.65, 0.05, 0, 1)
--duration-default: 0.75s
--design-width: 1728  --design-unit: 16  --scale-factor: 1
